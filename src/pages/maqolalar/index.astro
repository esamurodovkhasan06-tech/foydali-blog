
---
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = [
  {
    title: "Vaqtni samarali boshqarish",
    description: "Kundalik ishlarni rejalashtirish va vaqtdan unumli foydalanish bo‘yicha foydali tavsiyalar.",
    category: "Shaxsiy rivojlanish",
  },
  {
    title: "Kitob o‘qishning foydalari",
    description: "Mutolaa bilimni kengaytirish, fikrlash va dunyoqarashni rivojlantirishga yordam beradi.",
    category: "Ta’lim",
  },
  {
    title: "Tabiatni asrash — barchamizning vazifamiz",
    description: "Atrof-muhitni asrash uchun kundalik hayotda amalga oshirish mumkin bo‘lgan oddiy qadamlar.",
    category: "Jamiyat",
  },
];
---

<BaseLayout
  title="Maqolalar"
  description="Foydali Blog saytidagi foydali maqolalar to‘plami."
>
  <section class="container" style="padding-top: 48px; padding-bottom: 64px;">
    <h1>Maqolalar</h1>
    <p>Bilimingizni oshiring va hayotingizga foyda qo‘shing.</p>

    <div class="article-grid">
      {articles.map((article) => (
        <article class="article-card">
          <p>{article.category}</p>
          <h2>{article.title}</h2>
          <p>{article.description}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
