---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getCollection } from "astro:content";
const articles = (await getCollection("articles")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = articles.find((a) => a.data.featured) ?? articles[0];
const latest = articles.filter((a) => a.id !== featured?.id).slice(0, 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout title="Foydali Blog" description="Kundalik hayot, ta’lim, salomatlik va jamiyat haqida foydali, sodda va amaliy maqolalar.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow"><span class="eyebrow-dot"></span> Bilim ulashamiz</span>
        <h1>Har kuni ozgina bilim. <span>Katta o‘zgarish.</span></h1>
        <p>Hayotda asqotadigan fikrlar, foydali tavsiyalar va jamiyatimiz uchun kerakli maqolalar — barchasi bir joyda.</p>
        <div class="hero-actions">
          
        </div>
        <div class="hero-note"><span class="note-icon" aria-hidden="true">✦</span> Sizga xizmat ko'rsatishdan mamnunmiz.</div>
      </div>
      {featured && <div class="hero-feature">
        <img src={featured.data.image} alt={featured.data.imageAlt} />
        <div class="feature-overlay"></div>
        <div class="feature-caption">
          <span class="feature-label">Tavsiya etamiz</span>
          <span class="feature-category">{featured.data.category}</span>
         <h2><a href={`${base}/maqolalar/${featured.id}/`}>{featured.data.title}</a></h2>
          <p>{featured.data.description}</p>
          <a class="feature-link" href={`${base}maqolalar/${featured.id}/`}>Maqolani o‘qish <span aria-hidden="true">↗</span></a>
        </div>
      </div>}
    </div>
  </section>

  <section class="section section-tinted">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">Yangi bilimlar</span><h2>So‘nggi maqolalar</h2></div>
       <a class="text-link" href={`${import.meta.env.BASE_URL}/maqolalar/`}>
  Barchasini ko‘rish <span aria-hidden="true">→</span>
</a>
      </div>
      <div class="article-grid">
        {latest.map((article) => <ArticleCard
          href={`${base}maqolalar/${article.id}/`}
          title={article.data.title}
          description={article.data.description}
          image={article.data.image}
          imageAlt={article.data.imageAlt}
          category={article.data.category}
          author={article.data.author}
          pubDate={article.data.pubDate}
        />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container callout">
      <div class="callout-icon" aria-hidden="true">✳</div>
      <div><span class="eyebrow">Foydali odat</span><h2>Bilimni hayotga tatbiq eting</h2><p>Har bir maqoladan bitta foydali fikr tanlang va bugunoq amalda sinab ko‘ring.</p></div>
      <a class="button button-light" href={`${import.meta.env.BASE_URL}/kategoriyalar/`}>
  Mavzularni tanlash <span aria-hidden="true">→</span>
</a>
    </div>
  </section>
</BaseLayout>
