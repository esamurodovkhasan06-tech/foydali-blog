
---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Aloqa"
  description="Foydali Blog bilan bog‘laning."
>
  <section class="container" style="padding-top: 48px; padding-bottom: 64px;">
    <h1>Biz bilan bog‘laning</h1>
    <p>
      Savol, taklif yoki maqola g‘oyangiz bormi?
      Biz bilan quyidagi usullardan biri orqali bog‘laning.
    </p>

    <div class="contact-list">
      <a href="https://t.me/foydalibloguz" target="_blank" rel="noopener noreferrer">
        <strong>✈ Telegram kanalimiz</strong>
        <span>@foydalibloguz</span>
      </a>

      <a href="mailto:esamurodovkhasan@gmail.com">
        <strong>✉ Elektron pochta</strong>
        <span>esamurodovkhasan@gmail.com</span>
      </a>

      <a href="tel:+998999533206">
        <strong>☎ Telefon raqami</strong>
        <span>+998 99 953 32 06</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 18px;
    margin-top: 28px;
  }

  .contact-list a {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border: 1px solid var(--line, #e4eae5);
    border-radius: var(--radius, 18px);
    background: var(--soft, #f7f9f7);
    color: var(--ink, #17251c);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: transform 0.2s ease;
  }

  .contact-list a:hover {
    transform: translateY(-3px);
    border-color: var(--green, #14532d);
  }

  .contact-list strong {
    color: var(--green, #14532d);
  }

  .contact-list span {
    line-height: 1.6;
  }
</style>
