
---
import BaseLayout from "../../layouts/BaseLayout.astro";

const formUrl =
  "https://docs.google.com/forms/d/e/1FAIpQLSfRPPo7GhGfdMEONQeE0IlSITE_-gtgA2hPTGkbaNGf3oy9SA/viewform";
---

<BaseLayout
  title="Maqola yuborish"
  description="Foydali Blog saytiga o‘z maqolangizni yuboring."
>
  <section class="container submit-page">
    <h1>Maqolangizni bizga yuboring</h1>

    <p class="intro">
      Foydali bilim va yaxshi g‘oyalaringizni boshqalar bilan ulashing.
      Maqolangiz tahririyat tomonidan ko‘rib chiqiladi va faqat
      ma’qullangan maqolalar saytda e’lon qilinadi.
    </p>

    <div class="notice">
      <strong>Yuborishdan oldin</strong>
      <p>
        Maqolangizning to‘liq matnini kiriting, mos kategoriyani tanlang
        va mualliflik roziligini belgilang.
      </p>
    </div>

    <div class="form-wrap">
      <iframe
        src={`${formUrl}?embedded=true`}
        title="Foydali Blog maqola yuborish formasi"
        loading="lazy"
        width="100%"
        height="1200"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
      >
        Forma yuklanmoqda...
      </iframe>
    </div>

    <p class="fallback">
      Forma ko‘rinmayaptimi?
      <a href={formUrl} target="_blank" rel="noopener noreferrer">
        Maqola yuborish formasini alohida oynada oching ↗
      </a>
    </p>
  </section>
</BaseLayout>

<style>
  .submit-page {
    padding-top: 48px;
    padding-bottom: 64px;
  }

  .submit-page h1 {
    color: var(--ink, #17251c);
    margin-bottom: 14px;
  }

  .intro {
    max-width: 760px;
    color: var(--muted, #69766d);
    line-height: 1.8;
  }

  .notice {
    margin: 24px 0;
    padding: 18px 22px;
    border: 1px solid var(--line, #e4eae5);
    border-radius: var(--radius, 18px);
    background: var(--mint, #eaf4ec);
    color: var(--ink, #17251c);
    line-height: 1.7;
  }

  .notice p {
    margin-bottom: 0;
  }

  .form-wrap {
    overflow: hidden;
    border: 1px solid var(--line, #e4eae5);
    border-radius: var(--radius, 18px);
    background: white;
  }

  .form-wrap iframe {
    display: block;
    width: 100%;
    min-height: 1000px;
    border: 0;
  }

  .fallback {
    margin-top: 18px;
    line-height: 1.8;
  }

  .fallback a {
    color: var(--green, #14532d);
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .submit-page {
      padding-top: 30px;
      padding-bottom: 44px;
    }

    .form-wrap iframe {
      min-height: 1200px;
    }
  }
</style>
