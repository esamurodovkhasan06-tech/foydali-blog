
---
import BaseLayout from "../../layouts/BaseLayout.astro";

const categories = [
  {
    title: "Shaxsiy rivojlanish",
    description: "Vaqtni boshqarish, foydali odatlar va o‘z ustida ishlash.",
  },
  {
    title: "Ta’lim",
    description: "Bilim olish, kitobxonlik va yangi ko‘nikmalar.",
  },
  {
    title: "Jamiyat",
    description: "Jamiyat, atrof-muhit va kundalik hayot uchun foydali g‘oyalar.",
  },
];
---

<BaseLayout
  title="Kategoriyalar"
  description="Foydali Blog maqolalarining mavzulari."
>
  <section class="container" style="padding-top: 48px; padding-bottom: 64px;">
    <h1>Kategoriyalar</h1>
    <p>O‘zingizga kerakli mavzuni tanlang.</p>

    <div class="article-grid">
      {categories.map((category) => (
        <article class="article-card">
          <h2>{category.title}</h2>
          <p>{category.description}</p>
          <a class="text-link" href={`${import.meta.env.BASE_URL}maqolalar/`}>
            Maqolalarni ko‘rish →
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
